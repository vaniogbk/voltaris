# URL de l'API vue depuis le navigateur (obligatoire, exposée au client)
NEXT_PUBLIC_API_URL="http://localhost:4000"

# URL de l'API vue depuis le serveur Next.js (rendu RSC).
# En production sur Railway, préférez l'URL interne du service : plus rapide,
# non exposée publiquement. Si absente, NEXT_PUBLIC_API_URL est utilisée.
API_URL="http://localhost:4000"

# URL canonique du site, utilisée pour les balises canonical, hreflang,
# le sitemap et les données structurées. Sans slash final.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# "production" active l'indexation dans robots.txt.
# Toute autre valeur bloque les robots : gardez-la non renseignée en préprod.
NEXT_PUBLIC_ENV="development"

# Clé publique Stripe (pk_test_… ou pk_live_…). Laissez vide pour masquer le
# paiement carte côté interface.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
