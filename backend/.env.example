# ---------------------------------------------------------------- exécution
NODE_ENV=development
PORT=4000

# ---------------------------------------------------------------- base de données
# Local (docker compose up -d) :
DATABASE_URL="postgresql://stihl:stihl@localhost:5432/voltaris?schema=public"
# Railway : la variable est injectée automatiquement, utilisez ${{Postgres.DATABASE_URL}}

# ---------------------------------------------------------------- authentification
# Générez chaque secret avec : openssl rand -base64 48
JWT_ACCESS_SECRET="remplacez-moi-par-48-octets-aleatoires-minimum-32-caracteres"
JWT_REFRESH_SECRET="remplacez-moi-aussi-par-une-autre-valeur-aleatoire-differente"
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ---------------------------------------------------------------- CORS / frontend
# Origines autorisées, séparées par des virgules (sans slash final)
CORS_ORIGINS="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"

# ---------------------------------------------------------------- Stripe (optionnel)
# Laissez vide pour désactiver le paiement carte : seul le virement sera proposé.
# Clés de test : https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Obtenu via : stripe listen --forward-to localhost:4000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------- virement SEPA
# Coordonnées affichées au client sur la page de confirmation de commande.
BANK_ACCOUNT_HOLDER="Voltaris SAS"
BANK_IBAN="FR7630001007941234567890185"
BANK_BIC="BDFEFRPPCCT"
BANK_NAME="Banque de démonstration"
BANK_TRANSFER_DUE_DAYS=7

# ---------------------------------------------------------------- compte admin (seed)
ADMIN_EMAIL="admin@voltaris.eu"
ADMIN_PASSWORD="ChangeMoi!2026"

# ---------------------------------------------------------------- contact
# Formulaire de contact vers Telegram. Laissez vide pour masquer le formulaire
# et afficher uniquement votre adresse e-mail.
#   1. Creez un bot avec @BotFather sur Telegram, recuperez le jeton
#   2. Ecrivez un message a votre bot, puis ouvrez
#      https://api.telegram.org/bot<JETON>/getUpdates pour lire votre chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
